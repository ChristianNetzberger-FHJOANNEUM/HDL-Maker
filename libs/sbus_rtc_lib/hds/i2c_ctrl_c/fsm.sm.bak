archConcurrentStatementBlock *101 (BiTextGroup
uid 24,0
stg "VerticalLayoutStrategy"
first (Text
uid 25,0
va (VaSet
font "Arial,8,1"
)
xt "-28026,-8592,-18126,-7592"
st "Concurrent Statements"
blo "-28026,-7792"
)
second (MLText
uid 26,0
va (VaSet
)
xt "-28026,-7592,1974,19408"
st "mem2_waddr <= conv_std_logic_vector(reg_wrptr,8);
mem2_wdata <= rdata; --X\"0000\" & reg_tmp & i2creg_dout when reg_mux = '1' else
                         --X\"0000\" &   i2creg_dout & X\"00\";

mem1_raddr <= conv_std_logic_vector(reg_rdptr,8);

i2creg_addr <= reg_addr_int;
i2csel <= i2csel_int;
--reg_dout <= reg_dout_int;

---automatic scheduling of xfers ----------
process(clk)
begin
   if clk='1' and clk'event then
      if reset = '1' then
           auto_timer <= (others => '0');
           auto_en <= '0';
      else  
           auto_timer <= auto_timer+1;
           auto_en <= '0';
           if auto_timer = 99 then
                 auto_timer <= (others => '0');
                 auto_en <= '1';
           end if;
      end if;
   end if;
end process;"
tm "ArchConcStmtTextMgr"
)
associable 1
)
