archConcurrentStatementBlock *59 (BiTextGroup
uid 24,0
stg "VerticalLayoutStrategy"
first (Text
uid 25,0
va (VaSet
font "arial,8,1"
)
xt "-16,24056,9884,25056"
st "Concurrent Statements"
blo "-16,24856"
)
second (MLText
uid 26,0
va (VaSet
font "arial,8,0"
)
xt "-16,25056,17584,50056"
st "sdata <= led_data;

process(clk)
begin
    if rising_edge(clk) then
      if reset = '1' then
         bit_timer <= (others => '0');
         reset_timer <= (others => '0');
     else
         if bit_next = '1' then
            bit_timer <= (others => '0');
            reset_timer <= reset_timer + 1;
            if bit_reset = '1' then
                 reset_timer <= (others => '0');
            end if;
        else
            bit_timer <= bit_timer+1;
        end if;
      end if;
   end if;
end process;
bit_next <= '1' when bit_timer = bit_c-1 else '0';
bit_0 <= '1' when bit_timer = bit0_c-1 else '0';
bit_1 <= '1' when bit_timer = bit1_c-1 else '0';
bit_reset <= '1' when reset_timer = 49 else '0';"
tm "ArchConcStmtTextMgr"
)
associable 1
)
