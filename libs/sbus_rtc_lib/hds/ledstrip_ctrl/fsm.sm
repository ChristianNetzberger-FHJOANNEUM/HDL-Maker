)
xt "17779,-11042,38879,1958"
st "signal bit_timer: std_logic_vector(15 downto 0);
signal reset_timer: std_logic_vector(7 downto 0);
signal bit_next, bit_0,bit_1,bit_reset: std_logic;
signal txreg: std_logic_vector(rgb'range);
signal cnt: std_logic_vector(7 downto 0);
signal pix_cnt: std_logic_vector(15 downto 0);
signal led_data: std_logic;
signal data_sreg: std_logic_vector(din'range);

constant f_mhz_c: integer := core_clk_freq_g / 1_000_000;
constant bit0_c: integer := (40 * f_mhz_c)/100;
constant bit1_c: integer := (85 * f_mhz_c)/100;
constant bit_c: integer := (125 * f_mhz_c)/100;"
tm "LocalDeclTextMgr"
)
declType 2
)
