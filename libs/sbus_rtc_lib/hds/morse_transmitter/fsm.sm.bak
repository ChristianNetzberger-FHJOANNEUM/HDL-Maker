archConcurrentStatementBlock *71 (BiTextGroup
uid 24,0
stg "VerticalLayoutStrategy"
first (Text
uid 25,0
va (VaSet
font "arial,8,1"
)
xt "2048,27116,11948,28116"
st "Concurrent Statements"
blo "2048,27916"
)
second (MLText
uid 26,0
va (VaSet
font "arial,8,0"
)
xt "2048,28116,26548,67116"
st "---msec ticker ------------------
process(clk)
begin
   if rising_edge(clk) then
      if reset = '1' then
         ms_ticker <= (others => '0');
      else
            if ms_tick = '1' then
                ms_ticker <= (others => '0');
            else
                ms_ticker <= ms_ticker + 1;
            end if;
      end if;   
   end if;
end process;

--msec tick assuming 100MHz core clock--
ms_tick <= '1' when ms_ticker = 100000-1 else '0';

--- morse code speed timer ---------------
process(clk)
begin
   if rising_edge(clk) then
      if reset = '1' then
         morse_ticker <= (0 => '1', others => '0');
      elsif ms_tick = '1' then
            if morse_tick = '1' then
                morse_ticker <= (0=> '1', others => '0');
            else
                morse_ticker<= morse_ticker + 1;
            end if;
      end if;   
   end if;
end process;

--morse code speed ticker--
morse_tick <= ms_tick when morse_ticker = morse_speed else '0';

morse_code <= not morse_code_tmp;"
tm "ArchConcStmtTextMgr"
)
associable 1
)
