archConcurrentStatementBlock *44 (BiTextGroup
uid 18,0
stg "VerticalLayoutStrategy"
first (Text
uid 19,0
va (VaSet
font "Arial,8,1"
)
xt "1928,22184,11828,23184"
st "Concurrent Statements"
blo "1928,22984"
)
second (MLText
uid 20,0
va (VaSet
)
xt "1928,23184,28528,148184"
st "clk <= scl_i;
scl_o <= '1';
local_address <= \"0010010\";

process(sda_i,reset)
begin
  if reset = '1' then
     start_flag <= '0';
   elsif sda_i='0' and sda_i'event then
      start_flag <= scl_i;
   end if;
end process;

process(sda_i,reset,start_flag)
begin
  if reset = '1' or start_flag = '1' then
      stop_flag <= '0';
  elsif sda_i = '1' and sda_i'event then
      stop_flag <= scl_i;
   end if;
end process;

process(clk,reset,stop_flag)
begin
  if reset = '1' or stop_flag = '1' then
      start_flag_q0 <= '0';
      start_flag_q1 <= '0';
  elsif clk = '0' and clk'event then
      start_flag_q0 <= start_flag;
      start_flag_q1 <= start_flag_q0;
   end if;
end process;

start_condition <= not start_flag_q1 and start_flag_q0;

process(clk,start_condition,reset)
begin
  if reset = '1' or start_condition = '1' then
      cnt <= \"0001\";
     byte_cnt <= \"00\";
  elsif clk='0' and clk'event then
      if cnt = 8 then
          cnt <= (others => '0');
          if byte_cnt = \"10\" then
              byte_cnt <= \"01\";
          else
              byte_cnt <= byte_cnt+1;
          end if;
      else
          cnt <= cnt+1;
      end if;
   end if;
end process;

ack <=  cnt(3);
--sda_o <= not ack or not wr_flag;
sda_o <= txreg(7);

process(clk,reset)
begin
   if reset = '1'  then
      rxreg <=(others => '1');
      txreg <=(others => '1');
      reg0 <= (others => '0');
      reg0q <= (others => '0');
      reg1 <= (others => '0');
      wr_flag <= '0';
      rd_flag <= '0';
     address_match <= '1' ;
   elsif start_condition = '1' then
     address_match <= '1' ;
      txreg <= X\"FE\";
   elsif clk = '0' and clk'event then
      rxreg <= rxreg(rxreg'left-1 downto 0) & sda_i;
      txreg <= txreg(txreg'left-1 downto 0) &  (rd_flag or not address_match);
         if  byte_cnt = \"00\" and cnt = 7  then
            if local_address = rxreg(6 downto 0) then
               address_match <= '1' ;
               wr_flag <= not sda_i;
               rd_flag <= sda_i;
            else
               txreg <= X\"FF\";
              wr_flag <= '0';
              rd_flag <= '0';
              address_match <= '0' ;
            end if;   
        end if;           
        if ack = '1' then
          if byte_cnt = \"00\" then
             if rd_flag = '1' and sda_i = '0' then  -- only if acked by the master
                 txreg <= reg0_i;
                 reg1q <= reg1_i;
             else
                txreg <= X\"FF\";
             end if;
         elsif byte_cnt = \"01\" then
              reg0q <= rxreg;
             if rd_flag = '1' and sda_i = '0'  then
                 txreg <= reg1q;
             else
                txreg <= X\"FF\";
            end if;
         elsif byte_cnt = \"10\" then
                if wr_flag = '1' then
                   reg1 <= rxreg;
                   reg0 <= reg0q;
               end if;
             if rd_flag = '1' and sda_i = '0' then  -- only if acked by the master
                 txreg <= reg0_i;
                 reg1q <= reg1_i;
             else
                txreg <= X\"FF\";
             end if;
         elsif byte_cnt = \"11\" then
               txreg <= X\"FF\";
         end if;
      end if;
  end if;
end process;

-- output registers ----
reg0_o <= reg0;
reg1_o <= reg1;

--address_match <= '1' when local_address = rxreg(6 downto 0) else '0';"
tm "ArchConcStmtTextMgr"
)
associable 1
)
