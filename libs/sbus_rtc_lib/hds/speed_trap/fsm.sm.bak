archConcurrentStatementBlock *67 (BiTextGroup
uid 24,0
stg "VerticalLayoutStrategy"
first (Text
uid 25,0
va (VaSet
font "arial,8,1"
)
xt "-602,32988,9298,33988"
st "Concurrent Statements"
blo "-602,33788"
)
second (MLText
uid 26,0
va (VaSet
font "arial,8,0"
)
xt "-602,33988,25598,65988"
st "data <= phase & timer;

---- timer for measurement -------
process(clk)
begin
if rising_edge(clk) then
   if timer_reset = '1' then
       timer <= (others => '0');
   else
       timer <= timer + 1;
   end if;
end if;
end process;

---- usec ticker for guard time to de-bounce light barrier transitions -------
process(clk)
begin
if rising_edge(clk) then
   if reset = '1' then
       us_ticker <=  (others => '0');
   else
       if us_tick = '1' then
           us_ticker <=  (others => '0');
       else
           us_ticker <= us_ticker + 1;
       end if;
   end if;
end if;
end process;

---assume 100MHz core clock-----
us_tick <= '1' when us_ticker = 99 else '0';"
tm "ArchConcStmtTextMgr"
)
associable 1
)
