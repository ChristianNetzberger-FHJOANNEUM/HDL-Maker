text (MLText
uid 20993,0
va (VaSet
isHidden 1
font "arial,8,0"
)
xt "16200,118200,34300,132200"
st "
----synchronize external gpio inputs and select---
process(clk)
begin
   if rising_edge(clk) then
       gpio_s <= gpio_i;   -- first sync stage
       for i in 0 to 7 loop
            if i = light_barrier_1_mux then
                light_barrier_1 <= gpio_s(i);
            end if;
            if i = light_barrier_2_mux then
                light_barrier_2 <= gpio_s(i);
            end if;
        end loop;
   end if;
end process;
                                       
"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 14000
visibleWidth 21000
)
)
)
]
