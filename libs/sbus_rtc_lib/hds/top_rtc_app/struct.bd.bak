text (MLText
uid 1545,0
va (VaSet
font "arial,8,0"
)
xt "101200,76200,122700,90200"
st "
process(clk)
begin
   if rising_edge(clk) then
       if buzzer_select = \"00\"  then
            buzzer_tmp <= buzzer_wave & not buzzer_wave;  
       elsif buzzer_select = \"01\" then
            buzzer_tmp <= buzzer_reg & not buzzer_reg;
        elsif buzzer_select = \"10\" then
            buzzer_tmp <= buzzer_morse & not buzzer_morse;
      end if;
   end if;
end process;
buzzer <= buzzer_tmp;
                          
"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 14000
visibleWidth 23000
)
)
)
]
