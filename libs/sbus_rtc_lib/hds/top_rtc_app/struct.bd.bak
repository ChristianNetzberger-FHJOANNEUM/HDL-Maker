text (MLText
uid 282,0
va (VaSet
font "arial,8,0"
)
xt "103200,131200,121900,149200"
st "
-- Pmod - Debug Outputs ----------------
process(clk)
begin
   if rising_edge(clk) then
      if pmod_o_select = '0' then
          pmod_jc <= pmod_o;
          pmod_jc <= dma_rdata32(7 downto 0);
     else   
          pmod_jc(0) <=  dma_rd;
          pmod_jc(1) <=  dma_rd_stb;
          pmod_jc(2) <=  dma_rd_en;
          pmod_jc(3) <=  sample_en; --ledstrip_timer;
          pmod_jc(4) <=  leds(0);
          pmod_jc(7 downto 6) <= (others => '0');   
      end if;
   end if;
end process;      
                     
"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 21000
visibleWidth 23000
)
)
)
]
