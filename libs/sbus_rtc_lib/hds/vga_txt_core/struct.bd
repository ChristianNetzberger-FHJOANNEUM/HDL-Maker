text (MLText
uid 401,0
va (VaSet
font "arial,8,0"
)
xt "133200,40200,149400,57200"
st "
process(clk_vga)
begin
   if rising_edge(clk_vga) then
      vga_hs <= hsync;
      vga_vs <= vsync;
      vga_active <= h_active and v_active;     
      vga_r <= (others => '0');     
      vga_g <= (others => '0');       
      vga_b <= (others => '0');   
      if h_active = '1' and v_active = '1' then
         vga_r <= char_rgb( 23 downto 16);     
         vga_g <= char_rgb( 15 downto 8);     
         vga_b <= char_rgb(  7 downto 0);   
     end if;  
   end if;
end process;   
                            
"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 18000
visibleWidth 18000
)
)
)
]
