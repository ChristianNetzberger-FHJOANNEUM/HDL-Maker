second (MLText
uid 8,0
va (VaSet
font "arial,8,0"
)
xt "-10980,30124,22720,99124"
st "constant cmd_mode_normal_c: std_logic_vector(15 downto 0) := X\"0C01\"; -- disable shutdown
constant cmd_scan_limit_c: std_logic_vector(15 downto 0) := X\"0B07\"; -- scan all digits
constant cmd_decode_mode_c: std_logic_vector(15 downto 0) := X\"0900\"; -- no decoder
signal txdata, txreg: std_logic_vector(15 downto 0); -- 16 data bits 
signal disp_reg: std_logic_vector(31 downto 0);
signal tx : std_logic;
signal bitcnt,bytecnt: std_logic_vector(4 downto 0);
signal en_cnt: std_logic_vector(15 downto 0);
signal en: std_logic;
signal rdy: std_logic;
signal trig_reg: std_logic;
signal seven_seg_code: std_logic_vector(6 downto 0);
signal s8: std_logic_vector(7 downto 0);
signal dp_reg,blank_reg: std_logic_vector(7 downto 0);


function to_sevenseg(bcd_nibble: std_logic_vector(3 downto 0)) return std_logic_vector is
  variable segment_code: std_logic_vector(6 downto 0);
begin

-----------------------------------------------------------------------------------------------------------
--HEX-to-seven-segment decoder - active low
--   
--
-- segment encoding
--      0
--     ---  
--  5 |   | 1
--     ---   <- 6
--  4 |   | 2
--     ---
--      3
  
  case bcd_nibble is
  when X\"0\" =>  segment_code :=   \"1000000\" ;  
  when X\"1\" =>  segment_code :=   \"1111001\" ;  
  when X\"2\" =>  segment_code :=   \"0100100\" ;  
  when X\"3\" =>  segment_code :=   \"0110000\" ;  
  when X\"4\" =>  segment_code :=   \"0011001\" ;  
  when X\"5\" =>  segment_code :=   \"0010010\" ;  
  when X\"6\" =>  segment_code :=   \"0000010\" ;  
  when X\"7\" =>  segment_code :=   \"1111000\" ;  
  when X\"8\" =>  segment_code :=   \"0000000\" ;  
  when X\"9\" =>  segment_code :=   \"0010000\" ;  
  when X\"A\" =>  segment_code:=   \"0001000\" ;  
  when X\"B\" =>  segment_code :=   \"0000011\" ;  
  when X\"C\" =>  segment_code :=   \"1000110\" ;  
  when X\"D\" =>  segment_code :=   \"0100001\" ;  
  when X\"E\" =>  segment_code :=   \"0000110\" ;  
  when others =>  segment_code :=  \"0001110\" ;  
--           \"1111001\" when X\"1\",    
--           \"0100100\" when  X\"2\",  
--           \"0110000\" when  X\"3\",     
--           \"0011001\" when  X\"4\",  
--           \"0010010\" when  X\"5\",      
--           \"0000010\" when  X\"6\",     
--           \"1111000\" when  X\"7\",    
--           \"0000000\" when  X\"8\",      
--           \"0010000\" when  X\"9\",      
--           \"0001000\" when  X\"A\",      
--           \"0000011\" when  X\"B\",      
--           \"1000110\" when  X\"C\",      
--           \"0100001\" when  X\"D\",      
--           \"0000110\" when  X\"E\",      
--           \"0001110\" when  X\"F\",      
--           \"1111111\" when others;   --invalid code
    end case;
return segment_code;
end to_sevenseg;"
tm "LocalDeclTextMgr"
)
declType 2
)
