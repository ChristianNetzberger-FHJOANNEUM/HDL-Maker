archConcurrentStatementBlock *71 (BiTextGroup
uid 24,0
stg "VerticalLayoutStrategy"
first (Text
uid 25,0
va (VaSet
font "arial,8,1"
)
xt "32896,30592,42796,31592"
st "Concurrent Statements"
blo "32896,31392"
)
second (MLText
uid 26,0
va (VaSet
font "arial,8,0"
)
xt "32896,31592,54996,76592"
st "--serial data out ---
sda <= txreg(15);

process(clk)
begin
   if rising_edge(clk) then
      if reset = '1' then
        trig_reg <= '0';
      else
         if trig = '1' then
             trig_reg <= '1';
         elsif en = '1' then
             trig_reg <= '0';
         end if;
      end if;
   end if;
end process;

process(clk)
begin
   if rising_edge(clk) then
      if reset = '1' then
        en_cnt <= (others => '0');
      else
         if en = '1' then
             en_cnt <= (others => '0');
         else
              en_cnt <= en_cnt+1;
         end if;
      end if;
   end if;
end process;

en <= '1' when en_cnt = 999 else '0';

seven_seg_code <= not  to_sevenseg(disp_reg(3 downto 0));

s8(0) <= seven_seg_code(6);
s8(1) <= seven_seg_code(5);
s8(2) <= seven_seg_code(4);
s8(3) <= seven_seg_code(3);
s8(4) <= seven_seg_code(2);
s8(5) <= seven_seg_code(1);
s8(6) <= seven_seg_code(0);
s8(7) <= dp_reg(0);"
tm "ArchConcStmtTextMgr"
)
associable 1
)
