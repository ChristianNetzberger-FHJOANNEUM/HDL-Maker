process(clk)
begin
   if rising_edge(clk) then
      if audioloop_en = '0' then
            audio_in_left_o <= audio_in_left_tmp;
            audio_in_right_o <= audio_in_right_tmp;
      else
            audio_in_left_o <= audio_out_left_ip;
            audio_in_right_o <= audio_out_right_i;
       end if;
   end if;
end process;

                                      
"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 16000
visibleWidth 31000
)
)
