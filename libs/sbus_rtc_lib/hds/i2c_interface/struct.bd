text (MLText
uid 4073,0
va (VaSet
)
xt "59200,73200,70600,112200"
st "
--- interface multiplexer----
process(clk)
begin
   if clk='1' and clk'event then
       i2c_sda1_o  <= '0';
       i2c_sda1_t   <= '1';
       i2c_scl1_o   <= '0';
       i2c_scl1_t     <= '1';

       i2c_sda2_o  <= '0';
       i2c_sda2_t   <= '1';
       i2c_scl2_o   <= '0';
       i2c_scl2_t     <= '1';

       i2c_sda_o_1q <= '1';
       i2c_scl_o_1q  <= '1';
       i2c_sda_o_2q <= '1';
       i2c_scl_o_2q  <= '1';

       scl_i <= '1';
       sda_i <= '1';
       if i2csel(0) ='0'  then
          i2c_sda1_t <=   sda_o;
          i2c_scl1_t  <=  scl_o;
          i2c_scl_o_1q <= scl_o;
          i2c_sda_o_1q <= sda_o;
          sda_i <= i2c_sda1_i;
          scl_i <= i2c_scl1_i;
       elsif i2csel(0) ='1'  then
          i2c_sda2_t <=  sda_o;
          i2c_scl2_t  <= scl_o;
          i2c_sda_o_2q <= sda_o;
          i2c_scl_o_2q <= scl_o;
          sda_i <= i2c_sda2_i;
          scl_i <= i2c_scl2_i;
       end if;        
   end if;
end process;  
                             

"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 41000
visibleWidth 15000
)
)
)
]
