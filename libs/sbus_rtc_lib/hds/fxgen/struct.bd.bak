text (MLText
uid 272,0
va (VaSet
font "arial,8,0"
)
xt "38200,30200,50900,39200"
st "
-- add offset to signal
  process(clk)
    begin
      if clk='1' and clk'event then
           signal_o <= p + offset_i;    
           sync_o <= enable_wav_q1;
       end if;
