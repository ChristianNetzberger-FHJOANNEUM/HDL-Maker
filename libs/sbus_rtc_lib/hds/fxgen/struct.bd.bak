text (MLText
uid 259,0
va (VaSet
font "arial,8,0"
)
xt "22200,30200,36200,41200"
st "
--scale the signal
    process(clk)
    begin
       if clk='1' and clk'event then
          product <= level_i * waveform;
          enable_wav_q1 <= enable_wav;
       end if;
  end process;
-- word length reduction of product
p <= product(30 downto 15);
                                 
"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 11000
visibleWidth 15000
)
)
)
]
