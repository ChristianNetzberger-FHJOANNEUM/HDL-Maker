-- waveform selector
with wavesel_i select
   waveform <= sine  when \"0000\",
                         rectangle(31 downto 16) when \"0001\",
                         triangle(31 downto 16) when \"0010\",
                        ramp(31 downto 16) when \"0011\",
                        (others => '0') when others;
"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 8000
visibleWidth 21000
)
