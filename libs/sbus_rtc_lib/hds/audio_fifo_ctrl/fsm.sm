archConcurrentStatementBlock *59 (BiTextGroup
uid 24,0
stg "VerticalLayoutStrategy"
first (Text
uid 25,0
va (VaSet
font "arial,8,1"
)
xt "2705,29285,12605,30285"
st "Concurrent Statements"
blo "2705,30085"
)
second (MLText
uid 26,0
va (VaSet
font "arial,8,0"
)
xt "2705,30285,14305,46285"
st "process(clk)
begin
   if rising_edge(clk) then
      if reset = '1' then
         trig <= '0';
         trig_reg <= '0';
     else
         if fifo2_rxtrig = '1' then
           trig <= '1';
         elsif sample_en = '1' then
           trig <= '0';
           trig_reg <= trig;
         end if;
      end if;
   end if;
end process;"
tm "ArchConcStmtTextMgr"
)
associable 1
)
