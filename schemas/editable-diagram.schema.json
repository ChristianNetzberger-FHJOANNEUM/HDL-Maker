{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hdl-maker.local/schemas/editable-diagram.schema.json",
  "title": "Editable block diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "frame", "provenance", "instances", "nets", "wires"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^edg_[0-9a-f]{32}$" },
    "name": { "type": "string", "minLength": 1 },
    "entity_name": { "type": ["string", "null"] },
    "architecture_name": { "type": ["string", "null"] },
    "frame": { "$ref": "#/$defs/frame" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "generics": { "type": "array", "items": { "$ref": "#/$defs/genericDef" } },
    "instances": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
    "diagram_ports": { "type": "array", "items": { "$ref": "#/$defs/diagramPort" } },
    "junctions": { "type": "array", "items": { "$ref": "#/$defs/junction" } },
    "nets": { "type": "array", "items": { "$ref": "#/$defs/net" } },
    "wires": { "type": "array", "items": { "$ref": "#/$defs/wire" } },
    "embedded_blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "labels": { "type": "array", "items": { "$ref": "#/$defs/label" } },
    "preserved_records": { "type": "array" },
    "checks": { "type": "array" }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_x", "origin_y", "scale"],
      "properties": {
        "origin_x": { "type": "integer" },
        "origin_y": { "type": "integer" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library_id"],
      "properties": {
        "library_id": { "type": "string" },
        "origin": { "enum": ["import", "created"] },
        "source_diagram_id": { "type": ["string", "null"] },
        "source_path": { "type": ["string", "null"] },
        "source_sha256": { "type": ["string", "null"] }
      }
    },
    "genericDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type_text": { "type": ["string", "null"] },
        "default_text": { "type": ["string", "null"] }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "x", "y", "width", "height", "ports"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "component_name": { "type": ["string", "null"] },
        "component_library": { "type": ["string", "null"] },
        "design_unit_id": { "type": ["string", "null"] },
        "child_diagram_id": { "type": ["string", "null"] },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "hds_uid": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] },
        "generics": { "type": "array" },
        "ports": { "type": "array" }
      }
    },
    "diagramPort": {
      "type": "object",
      "required": ["id", "name", "x", "y", "box_width", "box_height"],
      "properties": {
        "default_text": { "type": ["string", "null"] }
      }
    },
    "junction": {
      "type": "object",
      "required": ["id", "x", "y"]
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "endpoints"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type_text": { "type": ["string", "null"] },
        "range_text": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "owner_id", "port_id"],
            "properties": {
              "slice_text": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points"],
      "properties": {
        "id": { "type": "string" },
        "net_id": { "type": ["string", "null"] },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } }
          }
        },
        "start": { "type": ["object", "null"] },
        "end": { "type": ["object", "null"] },
        "slice_text": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "name", "text", "x", "y", "width", "height"],
      "properties": { "text": { "type": "string" } }
    },
    "label": {
      "type": "object",
      "required": ["id", "text", "x", "y"]
    }
  }
}
