{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hdl-design-studio.local/schemas/design.schema.json",
  "title": "HDL Design Studio library inventory",
  "description": "Schema version 2 stores imported libraries, design-unit interfaces, and read-only diagram documents. Version 1 files still load. Diagram coordinates are not part of the VHDL interface. Keep this file aligned with backend/app/models/design.py.",
  "type": "object",
  "additionalProperties": false,
    "required": ["schema_version", "project_id", "name", "libraries", "design_units", "diagrams"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "project_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "libraries": {
      "type": "array",
      "items": { "$ref": "#/$defs/library" }
    },
    "design_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/designUnit" }
    },
    "diagrams": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagram" }
    }
  },
  "$defs": {
    "severity": { "enum": ["error", "warning", "info"] },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "unit_id": { "type": ["string", "null"] }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "start_line", "end_line"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type_text", "width_status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "direction": {
          "type": ["string", "null"],
          "enum": ["in", "out", "inout", "buffer", "linkage", null]
        },
        "type_text": { "type": "string", "minLength": 1 },
        "range_text": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "width_status": {
          "enum": ["literal", "scalar", "not_applicable", "unresolved"]
        },
        "default_text": { "type": ["string", "null"] }
      }
    },
    "generic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "generic_kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "generic_kind": {
          "enum": ["value", "type", "package", "function", "procedure", "unknown"]
        },
        "type_text": { "type": ["string", "null"] },
        "default_text": { "type": ["string", "null"] }
      }
    },
    "designUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "library_id",
        "kind",
        "name",
        "language",
        "source",
        "parse_status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "library_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "entity",
            "architecture",
            "package",
            "package_body",
            "configuration",
            "context"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "language": { "enum": ["vhdl", "systemverilog", "verilog", "unknown"] },
        "parent_name": { "type": ["string", "null"] },
        "generics": {
          "type": "array",
          "items": { "$ref": "#/$defs/generic" }
        },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "instantiates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source": { "$ref": "#/$defs/sourceSpan" },
        "parse_status": {
          "enum": ["parsed", "partial", "unsupported", "skipped"]
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "extension", "size", "role", "classification", "binary"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "extension": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "role": {
          "enum": [
            "vhdl",
            "systemverilog",
            "verilog",
            "block_diagram",
            "symbol",
            "state_diagram",
            "interface_diagram",
            "flowchart",
            "truth_table",
            "view_reference",
            "metadata_candidate",
            "unrecognized"
          ]
        },
        "classification": { "type": "string" },
        "binary": { "type": "boolean" }
      }
    },
    "importReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_id",
        "library_name",
        "root_path",
        "scanned_at",
        "files",
        "unit_ids",
        "counts",
        "diagnostics"
      ],
      "properties": {
        "library_id": { "type": "string", "minLength": 1 },
        "library_name": { "type": "string", "minLength": 1 },
        "root_path": { "type": "string", "minLength": 1 },
        "scanned_at": { "type": "string", "format": "date-time" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileEntry" }
        },
        "unit_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "view_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/viewReference" }
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "root_path", "imported_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "root_path": { "type": "string", "minLength": 1 },
        "imported_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "last_import": {
          "oneOf": [{ "$ref": "#/$defs/importReport" }, { "type": "null" }]
        }
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "library_id", "source_path", "sha256", "view", "parse_status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "library_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "view": { "enum": ["block", "symbol", "state", "unknown"] },
        "format_version": { "type": ["string", "null"] },
        "app_version": { "type": ["string", "null"] },
        "entity_name": { "type": ["string", "null"] },
        "architecture_name": { "type": ["string", "null"] },
        "machine_name": { "type": ["string", "null"] },
        "state_signal_name": { "type": ["string", "null"] },
        "parse_status": { "enum": ["parsed", "partial", "unsupported", "skipped"] },
        "instances": { "type": "array", "items": { "$ref": "#/$defs/diagramInstance" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/diagramPort" } },
        "nets": { "type": "array", "items": { "$ref": "#/$defs/diagramNet" } },
        "wires": { "type": "array", "items": { "$ref": "#/$defs/diagramWire" } },
        "embedded_blocks": { "type": "array", "items": { "$ref": "#/$defs/embeddedBlock" } },
        "junctions": { "type": "array", "items": { "$ref": "#/$defs/diagramJunction" } },
        "record_counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "preserved_records": { "type": "array", "items": { "$ref": "#/$defs/preservedRecord" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "vhdl_check": { "type": "array", "items": { "$ref": "#/$defs/vhdlCheck" } }
      }
    },
    "diagramGeneric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type_text": { "type": ["string", "null"] },
        "value": { "type": ["string", "null"] }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "diagramPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "direction": { "type": ["string", "null"], "enum": ["in", "out", "inout", "buffer", "linkage", null] },
        "type_text": { "type": ["string", "null"] },
        "range_text": { "type": ["string", "null"] },
        "hds_uid": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] },
        "marker_m": { "type": ["integer", "null"] },
        "x1": { "type": ["integer", "null"] },
        "y1": { "type": ["integer", "null"] },
        "x2": { "type": ["integer", "null"] },
        "y2": { "type": ["integer", "null"] }
      }
    },
    "diagramInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "component_name": { "type": ["string", "null"] },
        "component_library": { "type": ["string", "null"] },
        "hds_uid": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] },
        "x1": { "type": ["integer", "null"] },
        "y1": { "type": ["integer", "null"] },
        "x2": { "type": ["integer", "null"] },
        "y2": { "type": ["integer", "null"] },
        "generics": { "type": "array", "items": { "$ref": "#/$defs/diagramGeneric" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/diagramPort" } }
      }
    },
    "diagramNet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type_text": { "type": ["string", "null"] },
        "range_text": { "type": ["string", "null"] },
        "hds_uid": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] }
      }
    },
    "diagramWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hds_uid": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] },
        "start_object": { "type": ["integer", "null"] },
        "end_object": { "type": ["integer", "null"] },
        "net_object": { "type": ["integer", "null"] },
        "slice_text": { "type": ["string", "null"] },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" } }
      }
    },
    "embeddedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "number": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "hds_uid": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] },
        "x1": { "type": ["integer", "null"] },
        "y1": { "type": ["integer", "null"] },
        "x2": { "type": ["integer", "null"] },
        "y2": { "type": ["integer", "null"] }
      }
    },
    "diagramJunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hds_uid": { "type": ["string", "null"] },
        "hds_object": { "type": ["integer", "null"] },
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "preservedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_name", "line", "payload"],
      "properties": {
        "type_name": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "hds_object": { "type": ["integer", "null"] },
        "payload": { "type": "string" }
      }
    },
    "vhdlCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "viewReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "default_file": { "type": ["string", "null"] },
        "default_architecture": { "type": ["string", "null"] },
        "unrecognized_lines": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
